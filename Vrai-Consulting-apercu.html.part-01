r(--scroll-fade-size,min(12%, calc(var(--spacing) * 10))))}to{--scroll-fade-e:0px}}@keyframes tw-shimmer{0%{background-position:100% 0}to{background-position:0 0}}

@font-face {
  font-family: 'Vrai Manrope';
  src: url('data:font/woff2;base64,') format('woff2');
  font-weight: 200 800;
  font-display: swap;
}
.vrai-site {
  --vrai-green: #103f35;
  --vrai-paper: #f5f3e9;
  --vrai-orange: #ff783e;
  --vrai-soft: #c8d6ce;
  --vrai-line: #ffffff38;
  --vrai-margin: clamp(24px, 3.3vw, 72px);
  min-height: 100vh;
  color: var(--vrai-paper);
  background: var(--vrai-green);
  font-family: 'Vrai Manrope', 'Segoe UI', sans-serif;
  -webkit-font-smoothing: antialiased;
}
.vrai-site,
.vrai-site * {
  box-sizing: border-box;
}
.vrai-site a {
  color: inherit;
  text-decoration: none;
}
.vrai-site button {
  font: inherit;
}
.vrai-site a,
.vrai-site button {
  -webkit-tap-highlight-color: transparent;
}
.vrai-site a:focus-visible,
.vrai-site button:focus-visible,
.vrai-site video:focus-visible {
  outline: 3px solid var(--vrai-orange);
  outline-offset: 6px;
}
.vrai-site ::selection {
  color: var(--vrai-green);
  background: var(--vrai-orange);
}
.vrai-stage {
  max-width: 1920px;
  margin: 0 auto;
}
.vrai-skip {
  position: fixed;
  top: 12px;
  left: 16px;
  z-index: 10;
  padding: 14px 20px;
  background: var(--vrai-paper);
  color: var(--vrai-green) !important;
  transform: translateY(-180%);
}
.vrai-skip:focus {
  transform: translateY(0);
}
.vrai-header {
  display: flex;
  align-items: center;
  gap: 32px;
  min-height: 88px;
  margin: 0 var(--vrai-margin);
  border-bottom: 1px solid var(--vrai-line);
}
.vrai-founder {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  white-space: nowrap;
}
.vrai-founder > span {
  padding: 0 7px;
}
.vrai-nav {
  display: flex;
  align-items: center;
  gap: 32px;
  margin-left: auto;
  font-size: 14px;
}
.vrai-nav a {
  padding: 15px 0;
  transition: color 0.2s;
}
.vrai-nav a:hover {
  color: var(--vrai-orange);
}
.vrai-contact {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  min-height: 44px;
  padding: 11px 19px;
  background: var(--vrai-orange);
  color: #112f28 !important;
  font-size: 13px;
  font-weight: 700;
  transition: background 0.2s;
}
.vrai-contact:hover {
  background: #ff9c69;
}
.vrai-contact > span {
  font-size: 20px;
}
.vrai-hero {
  padding: 52px var(--vrai-margin) 28px;
}
.vrai-masthead {
  display: grid;
  grid-template-columns: 54% 1fr;
  gap: 6%;
  align-items: start;
  position: relative;
  z-index: 1;
}
.vrai-wordmark {
  display: block;
  width: 100%;
}
.vrai-wordmark svg {
  display: block;
  width: 100%;
  height: auto;
  overflow: hidden;
}
.vrai-wordmark-sub {
  display: block;
  padding-top: 3.7%;
  font-size: clamp(16px, 2.75vw, 52px);
  font-weight: 600;
  line-height: 1;
  letter-spacing: 0.42em;
  text-align: center;
  padding-left: 0.42em;
}
.vrai-logo-reveal svg path {
  animation: vrai-letter-in 0.7s cubic-bezier(0.2, 0.7, 0.25, 1) both;
}
.vrai-logo-reveal svg path:nth-child(2) {
  animation-delay: 0.07s;
}
.vrai-logo-reveal svg path:nth-child(3) {
  animation-delay: 0.14s;
}
.vrai-logo-reveal svg path:nth-child(4) {
  animation-delay: 0.21s;
}
.vrai-logo-reveal .vrai-wordmark-sub {
  animation: vrai-copy-in 0.65s 0.3s both;
}
.vrai-positioning {
  margin: 5px 0 0;
  max-width: 470px;
  font-size: clamp(21px, 2.25vw, 40px);
  line-height: 1.45;
  font-weight: 400;
  letter-spacing: -0.035em;
}
.vrai-hero-bottom {
  display: grid;
  grid-template-columns: 37% 63%;
  align-items: center;
  margin-top: -18px;
}
.vrai-manifesto {
  position: relative;
  z-index: 2;
  padding-top: 28px;
}
.vrai-manifesto h1 {
  margin: 0;
  font-size: clamp(32px, 3.9vw, 73px);
  line-height: 1.1;
  letter-spacing: -0.05em;
  font-weight: 800;
}
.vrai-manifesto > p {
  margin: 26px 0 0;
  font-size: clamp(16px, 1.45vw, 25px);
  line-height: 1.65;
  letter-spacing: -0.02em;
}
.vrai-feature {
  margin: -65px -22px 0 0;
  position: relative;
  min-width: 0;
  scroll-margin-top: 28px;
}
.vrai-art-link {
  display: block;
  position: relative;
}
.vrai-art {
  width: 100%;
  height: auto;
  display: block;
  mask-image:
    linear-gradient(to right, transparent, black 7%, black 95%, transparent),
    linear-gradient(to bottom, transparent, black 9%, black 94%, transparent);
  mask-composite: intersect;
  transition: transform 0.65s cubic-bezier(0.2, 0.7, 0.25, 1);
}
.vrai-art-link:hover .vrai-art {
  transform: translateY(-5px);
}
.vrai-play {
  display: grid;
  place-items: center;
  position: absolute;
  bottom: 10%;
  left: 5%;
  width: clamp(56px, 5.5vw, 90px);
  aspect-ratio: 1;
  border-radius: 50%;
  background: var(--vrai-orange);
  color: #103f35;
  box-shadow: 0 6px 28px #082c2329;
  transition:
    transform 0.3s,
    background 0.3s;
}
.vrai-play svg {
  width: 32%;
  fill: currentColor;
  transform: translateX(-1px);
}
.vrai-art-link:hover .vrai-play {
  transform: scale(1.08);
  background: #ffa173;
}
.vrai-feature-caption {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 2px 24px 0 5%;
}
.vrai-feature-number {
  font-size: 13px;
  align-self: stretch;
  display: flex;
  align-items: center;
  padding-right: 20px;
  border-right: 1px solid #ffffff6b;
  font-variant-numeric: tabular-nums;
}
.vrai-film-link {
  display: block;
  padding: 5px 0;
}
.vrai-film-link strong {
  display: block;
  font-size: clamp(18px, 1.6vw, 28px);
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: -0.03em;
}
.vrai-film-link > span {
  display: flex;
  gap: 9px;
  align-items: center;
  margin-top: 8px;
  font-size: 13px;
  color: var(--vrai-soft);
}
.vrai-film-link:hover strong {
  text-decoration: underline;
  text-underline-offset: 5px;
  text-decoration-thickness: 1px;
}
.vrai-duration {
  padding-left: 4px;
  font-variant-numeric: tabular-nums;
}
.vrai-fiction {
  margin-left: auto;
  font-size: 11px;
  white-space: nowrap;
  color: var(--vrai-soft);
}
.vrai-discover {
  display: inline-flex;
  align-items: center;
  gap: 20px;
  margin-top: 10px;
  min-height: 44px;
  font-size: 13px;
}
.vrai-discover span {
  font-size: 21px;
  transition: transform 0.2s;
}
.vrai-discover:hover span {
  transform: translateY(4px);
}
.vrai-about {
  display: grid;
  grid-template-columns: 28% 1fr;
  gap: 8%;
  background: var(--vrai-paper);
  color: var(--vrai-green);
  padding: 88px var(--vrai-margin) 96px;
  margin-top: 14px;
  scroll-margin-top: 0;
}
.vrai-about-label {
  display: flex;
  gap: 24px;
  align-items: baseline;
  padding-top: 12px;
  font-size: 12px;
  font-weight: 700;
}
.vrai-about-label span {
  color: #526a5e;
}
.vrai-about h2 {
  font-size: clamp(30px, 3.4vw, 58px);
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: -0.055em;
  margin: 0 0 40px;
}
.vrai-about-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 36px;
  max-width: 830px;
}
.vrai-about-details p {
  font-size: 15px;
  line-height: 1.85;
  margin: 0;
}
.vrai-about-demo {
  display: inline-flex;
  align-items: center;
  gap: 40px;
  margin-top: 30px;
  min-height: 44px;
  border-bottom: 1px solid var(--vrai-green);
  font-size: 14px;
  font-weight: 600;
}
.vrai-about-demo span {
  font-size: 23px;
}
.vrai-footer {
  display: flex;
  align-items: center;
  gap: 40px;
  padding: 38px var(--vrai-margin);
}
.vrai-footer > a:first-child {
  width: 108px;
}
.vrai-footer .vrai-wordmark-sub {
  font-size: 7px;
}
.vrai-footer > span {
  margin-left: auto;
  font-size: 12px;
}
.vrai-footer > a:last-child {
  font-size: 12px;
  color: var(--vrai-soft);
  padding: 14px 0;
}
.vrai-film-dialog {
  position: fixed;
  inset: 0;
  width: min(1200px, calc(100vw - 48px));
  max-width: none;
  max-height: calc(100dvh - 48px);
  padding: 0;
  margin: auto;
  border: 1px solid #ffffff30;
  color: var(--vrai-paper);
  background: #0b2923;
  overflow: auto;
  overscroll-behavior: contain;
}
.vrai-film-dialog::backdrop {
  background: #031710ed;
  backdrop-filter: blur(10px);
}
.vrai-film-top {
  display: flex;
  gap: 24px;
  justify-content: space-between;
  align-items: center;
  padding: 22px 28px;
}
.vrai-film-top h2 {
  margin: 0;
  font-size: 23px;
  font-weight: 600;
  letter-spacing: -0.03em;
}
.vrai-film-top p {
  margin: 5px 0 0;
  font-size: 12px;
  color: var(--vrai-soft);
}
.vrai-film-close {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border: 1px solid #ffffff48;
  color: var(--vrai-paper);
  background: transparent;
  cursor: pointer;
}
.vrai-film-close:hover {
  background: #ffffff14;
}
.vrai-film-video {
  display: block;
  width: 100%;
  max-height: calc(100dvh - 240px);
  aspect-ratio: 16/9;
  background: #051f18;
}
.vrai-film-bottom {
  display: flex;
  gap: 20px;
  justify-content: space-between;
  padding: 19px 28px;
  font-size: 12px;
  color: var(--vrai-soft);
}
.vrai-film-bottom a {
  text-decoration: underline;
  text-underline-offset: 4px;
}
.vrai-film-error {
  padding: 12px 28px;
  color: var(--vrai-paper);
}
.vrai-film-error a {
  text-decoration: underline;
}
@keyframes vrai-letter-in {
  from {
    transform: translateY(105%);
  }
  to {
    transform: translateY(0);
  }
}
@keyframes vrai-copy-in {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@media (min-width: 1600px) {
  .vrai-hero {
    padding-top: 66px;
  }
  .vrai-hero-bottom {
    margin-top: -24px;
  }
}
@media (max-width: 1100px) {
  .vrai-header {
    gap: 22px;
  }
  .vrai-nav {
    gap: 22px;
  }
  .vrai-founder {
    font-size: 10px;
    letter-spacing: 0.12em;
  }
  .vrai-hero {
    padding-top: 38px;
  }
  .vrai-feature {
    margin-top: -35px;
  }
  .vrai-fiction {
    display: none;
  }
  .vrai-feature-caption {
    gap: 14px;
  }
  .vrai-manifesto > p {
    margin-top: 22px;
    font-size: 16px;
  }
  .vrai-about {
    gap: 5%;
    grid-template-columns: 26% 1fr;
    padding-top: 64px;
    padding-bottom: 64px;
  }
}
@media (max-width: 760px) {
  .vrai-header {
    min-height: 76px;
    flex-wrap: wrap;
    gap: 0 16px;
    justify-content: space-between;
    padding: 14px 0;
  }
  .vrai-founder {
    font-size: 9px;
    letter-spacing: 0.12em;
  }
  .vrai-founder > span {
    padding: 0 2px;
  }
  .vrai-nav {
    order: 3;
    width: 100%;
    justify-content: flex-end;
    gap: 24px;
    font-size: 12px;
    margin-top: 5px;
  }
  .vrai-nav a {
    padding: 10px 0;
  }
  .vrai-contact {
    min-height: 44px;
    padding: 9px 12px;
    gap: 12px;
    font-size: 11px;
  }
  .vrai-hero {
    padding-top: 32px;
    padding-bottom: 22px;
  }
  .vrai-masthead {
    grid-template-columns: 1fr;
    gap: 26px;
  }
  .vrai-wordmark-sub {
    font-size: clamp(20px, 5vw, 34px);
    padding-top: 5%;
  }
  .vrai-positioning {
    font-size: 21px;
    line-height: 1.5;
    margin: 0;
    max-width: none;
  }
  .vrai-hero-bottom {
    grid-template-columns: 1fr;
    margin-top: 30px;
  }
  .vrai-manifesto {
    padding: 0;
  }
  .vrai-manifesto h1 {
    font-size: clamp(36px, 7.5vw, 54px);
    line-height: 1.1;
  }
  .vrai-manifesto > p {
    font-size: 16px;
    margin-top: 18px;
  }
  .vrai-feature {
    margin: 8px -18px 0;
  }
  .vrai-art {
    mask-image:
      linear-gradient(to right, transparent, black 5%, black 96%, transparent),
      linear-gradient(to bottom, transparent, black 9%, black 94%, transparent);
  }
  .vrai-play {
    width: 60px;
    bottom: 8%;
    left: 6%;
  }
  .vrai-feature-caption {
    padding: 12px 18px 0;
    align-items: flex-start;
  }
  .vrai-feature-number {
    padding-right: 16px;
  }
  .vrai-film-link strong {
    font-size: 20px;
  }
  .vrai-film-link > span {
    font-size: 12px;
    gap: 7px;
    flex-wrap: wrap;
  }
  .vrai-fiction {
    display: block;
    position: absolute;
    right: 22px;
    bottom: 88px;
    font-size: 10px;
  }
  .vrai-discover {
    margin-top: 30px;
    font-size: 12px;
  }
  .vrai-about {
    display: block;
    padding: 44px var(--vrai-margin) 50px;
    margin-top: 0;
  }
  .vrai-about-label {
    margin-bottom: 28px;
    padding: 0;
  }
  .vrai-about h2 {
    font-size: 34px;
    margin-bottom: 28px;
  }
  .vrai-about-details {
    grid-template-columns: 1fr;
    gap: 18px;
  }
  .vrai-about-details p {
    font-size: 15px;
  }
  .vrai-footer {
    gap: 24px 16px;
    padding-top: 28px;
    padding-bottom: 28px;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .vrai-footer > span {
    margin: 0;
    font-size: 11px;
  }
  .vrai-footer > a:last-child {
    width: 100%;
    padding-top: 0;
  }
  .vrai-film-dialog {
    width: calc(100vw - 24px);
    max-height: calc(100dvh - 24px);
  }
  .vrai-film-top {
    padding: 16px;
  }
  .vrai-film-top h2 {
    font-size: 20px;
  }
  .vrai-film-top p {
    max-width: 230px;
    font-size: 11px;
  }
  .vrai-film-bottom {
    padding: 16px;
    font-size: 11px;
    flex-wrap: wrap;
  }
  .vrai-film-video {
    max-height: calc(100dvh - 220px);
  }
}
@media (max-width: 380px) {
  .vrai-header {
    gap: 8px;
  }
  .vrai-contact {
    font-size: 10px;
    gap: 8px;
  }
  .vrai-founder {
    font-size: 8px;
  }
  .vrai-manifesto h1 {
    font-size: 33px;
  }
  .vrai-positioning {
    font-size: 18px;
  }
  .vrai-film-link strong {
    font-size: 18px;
  }
}
@media (prefers-reduced-motion: reduce) {
  .vrai-site *,
  .vrai-site *::before,
  .vrai-site *::after {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
}
