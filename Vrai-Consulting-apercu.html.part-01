font-weight:600;display:flex}.form-field.wide,.wide{grid-column:1/-1}.form-field input,[data-slot=select-trigger]{min-height:42px;font-size:.9375rem}.form-field textarea{resize:vertical;min-height:90px;font-size:.9375rem;line-height:1.5}.form-field .questions-area{min-height:170px}.detail-sheet[data-slot=sheet-content]{background:#faf9f5;gap:0;width:min(690px,100%);max-width:690px}.interview-sheet[data-slot=sheet-content]{width:min(780px,100%);max-width:780px}.sheet-bar{color:#f3f0e8;background:#172724;justify-content:space-between;align-items:center;padding:12px 22px;display:flex}.sheet-bar>span{font:650 .6875rem var(--font-geist-mono);letter-spacing:.11em}.sheet-bar button{color:#fff}.sheet-body{flex:1;min-height:0;padding:28px;overflow:auto}.sheet-body>[data-slot=sheet-title]{letter-spacing:-.04em;font-size:2.25rem;line-height:1.05}.sheet-body>[data-slot=sheet-description]{color:#69706b;margin:8px 0 26px}.sheet-body>.form-field{margin:17px 0}.sheet-form{margin:0}.sheet-actions{background:#eeece5;border-top:1px solid #cbc8c0;justify-content:flex-end;gap:9px;padding:15px 22px;display:flex}.score-editor{border-top:2px solid #172724;margin-top:26px}.score-editor label{border-bottom:1px solid #d3d0c8;padding:17px 2px;display:block}.score-editor label>span{justify-content:space-between;margin-bottom:13px;font-size:.875rem;display:flex}.score-editor label b{font:600 .75rem var(--font-geist-mono);color:#c44220}.score-editor [data-slot=slider-track]{background:#d3d0c8}.score-editor [data-slot=slider-range]{background:#ee5f35}.score-total{color:#fff;background:#172724;justify-content:space-between;align-items:flex-end;margin-top:22px;padding:18px 20px;display:flex}.score-total>span{font:600 .6875rem var(--font-geist-mono);letter-spacing:.1em}.score-total strong{font:500 2rem var(--font-geist-mono)}.score-total small{color:#a7b2af;font-size:.75rem}.debrief-divider{border-top:2px solid #172724;border-bottom:1px solid #cbc8c0;justify-content:space-between;align-items:center;padding:15px 0;display:flex}.debrief-divider>span{font:650 .6875rem var(--font-geist-mono);letter-spacing:.11em}.debrief-divider button{background:0 0;border:0;align-items:center;gap:9px;font-size:.875rem;display:flex}.follow-up{padding:15px 0}.mode-chip{font:600 .75rem var(--font-geist-mono);color:#c2cbc8;border:1px solid #5b6b67;padding:5px 8px}.loading-screen [data-slot=skeleton]{background:#485b57}@media (max-width:1200px){.metric-strip{grid-template-columns:repeat(4,1fr)}.metric-strip article:nth-child(4){border-right:0}.pipeline{grid-template-columns:repeat(9,245px)}}@media (max-width:840px){.cockpit-shell{display:block!important}.rail{display:none}.mobile-top{color:#fff;background:#172724;justify-content:space-between;align-items:center;padding:14px 20px;display:flex}.mobile-top .rail-brand>span{width:38px;height:38px}.page{padding:34px 24px 60px}.page-heading{align-items:flex-start}.page-heading h1{font-size:3.35rem}.chapter{display:none}.mission-card{grid-template-columns:95px 1fr}.mission-card>button{border-radius:0;grid-column:1/-1;margin:0}.metric-strip{grid-template-columns:repeat(4,1fr)}.hq-grid,.interview-layout,.offer-layout,.track-grid{grid-template-columns:1fr}.offer-tracks{display:flex;overflow-x:auto}.offer-tracks .section-label{display:none}.offer-tracks>button{border:1px solid #c4c1b9;min-width:260px}.alert,.notice{margin-left:24px;margin-right:24px}}@media (max-width:620px){.page-heading,.page-heading.compact{flex-direction:column;align-items:flex-start}.page-heading h1,.page-heading.compact h1{font-size:2.55rem}.metric-strip{grid-template-columns:repeat(2,1fr)}.metric-strip article:nth-child(2n){border-right:0}.form-grid{grid-template-columns:1fr}.form-field.wide,.wide{grid-column:auto}.offer-sentence{grid-template-columns:1fr}.offer-sentence>span{padding-top:10px}.interview-list>button{grid-template-columns:8px 1fr 18px}.interview-state{display:none}.track-card{min-height:250px}.debrief-divider{flex-direction:column;align-items:flex-start;gap